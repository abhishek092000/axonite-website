---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const jobs = (await getCollection("careers", ({ data }) => data.open)).map((job) => ({
  ...job,
  description: job.body.trim(),
}));
---

<SiteLayout title="Careers | Axonite Technology" description="Join Axonite to build product software that finance teams, field crews, and shift workers depend on.">
  <section class="bg-paper py-24 section-rule">
    <div class="max-w-container mx-auto px-6">
      <div class="max-w-3xl reveal">
        <p class="eyebrow mb-4">Careers</p>
        <h1 class="text-display max-w-[14ch]">Build product software that lasts.</h1>
        <p class="mt-5 max-w-[58ch] text-[1.05rem] leading-relaxed text-ink-2">
          We are a small team with a high bar. If you care about reliability, ownership, and clear execution, we’d like to hear from you.
        </p>
      </div>

      <div class="mt-14 grid gap-6">
        {jobs.map((job) => (
          <article class="card p-8 reveal">
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
              <div>
                <p class="font-mono-label text-[0.68rem] text-ink-3">{job.data.type}</p>
                <h2 class="mt-3 text-display-xs">{job.data.title}</h2>
              </div>
              <div class="text-sm text-ink-2 md:text-right">
                <p>{job.data.location}</p>
                {job.data.experience && <p>{job.data.experience}</p>}
              </div>
            </div>
            <p class="mt-5 max-w-[60ch] text-[0.95rem] leading-relaxed text-ink-2">{job.description}</p>
            <div class="mt-6">
              <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white">Apply now <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
