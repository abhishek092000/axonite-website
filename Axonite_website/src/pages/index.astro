---
import { products, process } from "../data/content.js";
import SiteLayout from "../layouts/SiteLayout.astro";

const metrics = [
  { value: "3", label: "Products in production, each doing one job well" },
  { value: "11", label: "Engineers, designers, and support specialists" },
  { value: "2026", label: "Founded in Pune, shipping from day one" },
  { value: "10 yr", label: "The horizon we build every product against" },
];
---

<SiteLayout title="Axonite Technology | Product software that lasts" description="Axonite builds and runs product software for teams that cannot afford downtime.">
  <section class="relative overflow-hidden bg-paper ambient-wash pt-32 pb-16 section-rule">
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(#0f766e 1px,transparent 1px);background-size:28px 28px;mask-image:radial-gradient(ellipse 75% 65% at 50% 20%,black 50%,transparent 100%)"></div>
    </div>
    <div class="hero-grid relative max-w-container mx-auto px-6">
      <div class="hero-copy">
        <p class="eyebrow mb-5">Axonite Technology Pvt Ltd — Product software</p>
        <h1 class="text-display max-w-[15ch]">Software that stays useful after launch day.</h1>
        <p class="mt-6 max-w-[46ch] text-[1.16rem] leading-relaxed text-ink-2">
          We build and run product software for teams that can't afford downtime — finance operations, field service, and product planning. Fewer features, all of them load-bearing.
        </p>
        <div class="flex flex-wrap gap-3 mt-9">
          <a href="/contact/" class="inline-flex items-center justify-center bg-accent text-white font-semibold text-[0.9375rem] px-7 py-3.5 rounded-full transition-colors hover:bg-accent-strong">Book a walkthrough</a>
          <a href="/services/" class="inline-flex items-center justify-center border border-line text-ink font-semibold text-[0.9375rem] px-7 py-3.5 rounded-full transition-colors hover:border-ink-3">See what we build</a>
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-12 pt-6 border-t border-line text-[0.85rem] text-ink-3">
          <span><strong class="text-ink font-semibold">In production today</strong> — three products across finance, field, and product</span>
          <span>Pune, India — serving teams nationwide</span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-orbit hero-orbit--outer"></div>
        <div class="hero-orbit hero-orbit--inner"></div>
        <div class="hero-dashboard">
          <div class="hero-dashboard__top">
            <div class="hero-window-dots"><i></i><i></i><i></i></div>
            <span>AXONITE / OPERATIONS</span>
            <span class="hero-live"><i></i> LIVE</span>
          </div>
          <div class="hero-dashboard__body">
            <div class="hero-dash-heading">
              <div><span class="hero-overline">MONITORING</span><h2>System overview</h2></div>
              <span class="hero-period">Last 30 days⌄</span>
            </div>
            <div class="hero-stat">
              <div><span class="hero-stat__label">Service availability</span><p>99.98<span>%</span></p></div>
              <span class="hero-stat__change">↗ 0.04%</span>
            </div>
            <div class="hero-chart">
              <div class="hero-chart__grid"><i></i><i></i><i></i></div>
              <svg viewBox="0 0 420 110" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="hero-chart-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#8065e8" stop-opacity=".22" />
                    <stop offset="100%" stop-color="#8065e8" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <path d="M0 75 C28 70 35 79 61 64 S98 71 121 53 S158 64 184 45 S220 53 247 38 S282 48 310 28 S346 39 371 19 S398 27 420 12 V110 H0Z" fill="url(#hero-chart-fill)" />
                <path d="M0 75 C28 70 35 79 61 64 S98 71 121 53 S158 64 184 45 S220 53 247 38 S282 48 310 28 S346 39 371 19 S398 27 420 12" fill="none" stroke="#6950d2" stroke-width="3" stroke-linecap="round" />
                <circle cx="371" cy="19" r="5" fill="#fff" stroke="#6950d2" stroke-width="3" />
              </svg>
              <div class="hero-chart__labels"><span>JUN 01</span><span>JUN 08</span><span>JUN 15</span><span>JUN 22</span><span>JUN 30</span></div>
            </div>
            <div class="hero-dashboard__footer">
              <div><i class="hero-footer-dot hero-footer-dot--purple"></i><span>Services online</span><strong>12 / 12</strong></div>
              <div><i class="hero-footer-dot hero-footer-dot--teal"></i><span>Incidents today</span><strong>0</strong></div>
            </div>
          </div>
        </div>
        <div class="hero-float-card">
          <span class="hero-float-card__icon">✓</span>
          <span><strong>All systems go</strong><small>Every product in sync</small></span>
        </div>
        <div class="hero-art__spark hero-art__spark--one"></div>
        <div class="hero-art__spark hero-art__spark--two"></div>
      </div>
    </div>
    <div class="relative mt-14" aria-hidden="true">
      <svg class="w-full h-16 md:h-20" viewBox="0 0 1200 80" fill="none" preserveAspectRatio="none">
        <path d="M0 40H240L280 15H420L460 62H660L700 30H850L890 50H1200" stroke="var(--accent)" stroke-opacity=".35" stroke-width="1.5" stroke-dasharray="6 7" />
        <circle cx="280" cy="15" r="4" fill="var(--accent)" /><circle cx="460" cy="62" r="4" fill="var(--accent-bright)" /><circle cx="700" cy="30" r="4" fill="var(--accent)" /><circle cx="890" cy="50" r="4" fill="var(--accent-bright)" />
      </svg>
    </div>
  </section>

  <section class="bg-paper pb-4">
    <div class="max-w-container mx-auto px-6">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-line-soft border border-line rounded-md overflow-hidden">
        {metrics.map((metric) => <div class="bg-white px-6 py-7"><p class="font-serif text-[clamp(1.9rem,1.4rem+1.4vw,2.5rem)] leading-none tracking-[-0.03em] text-ink">{metric.value}</p><p class="mt-2.5 text-[0.9rem] leading-snug text-ink-2">{metric.label}</p></div>)}
      </div>
    </div>
  </section>

  <section class="bg-paper py-24 section-rule mt-20">
    <div class="max-w-container mx-auto px-6">
      <div class="max-w-[720px] mb-12 reveal">
        <p class="eyebrow mb-4">What we run</p>
        <h2 class="text-display-sm max-w-[20ch]">Three products, each doing one job well.</h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-ink-2">We would rather run three products properly than eight adequately. Everything we ship is built to still be supported in ten years.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {products.map((product) => <a href={product.website || "/products/"} target={product.website ? "_blank" : undefined} rel={product.website ? "noopener noreferrer" : undefined} class="card card--hover flex flex-col p-7 h-full reveal"><p class="font-mono-label text-[0.7rem] text-ink-3 mb-4">{product.tag}</p><h3 class="text-display-xs">{product.name}</h3><p class="mt-3 text-[0.9rem] leading-relaxed text-ink-2">{product.desc}</p><span class="mt-auto pt-6 inline-flex items-center gap-1.5 text-[0.85rem] font-semibold text-accent">{product.website ? "Visit website" : "Product detail"} <span aria-hidden="true">{product.website ? "↗" : "→"}</span></span></a>)}
      </div>
    </div>
  </section>

  <section class="section-dark section-rule py-24">
    <div class="max-w-container mx-auto px-6">
      <div class="max-w-[720px] mb-12 reveal">
        <p class="eyebrow mb-4">How a project moves</p>
        <h2 class="text-display-sm max-w-[20ch]">A process that doesn't hide the middle part.</h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed">Five stages, repeated every release. Nothing reaches production until it has passed the checks we agreed on together.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-x-6 gap-y-10">
        {process.map((step, index) => <div class="border-t border-line-dark pt-5 reveal"><p class="font-mono-label text-[0.7rem] text-accent-bright mb-3">0{index + 1}</p><h3 class="text-[1.15rem] mb-2">{step.step}</h3><p class="text-[0.875rem] leading-relaxed">{step.desc}</p></div>)}
      </div>
    </div>
  </section>

  <section class="bg-paper py-24 section-rule">
    <div class="max-w-container mx-auto px-6">
      <div class="relative grid lg:grid-cols-[minmax(0,1fr)_auto] gap-6 items-center px-8 py-12 lg:px-12 border border-line-dark rounded-lg overflow-hidden bg-[linear-gradient(150deg,#151923_0%,#0a1c1a_100%)] reveal">
        <div class="relative"><h2 class="text-display-xs !text-ink-inverse">Have a product that needs to be built or enhanced?</h2><p class="mt-3 max-w-[46ch] text-[0.9375rem] leading-relaxed !text-ink-inverse-2">From new product development to improving existing systems, we build software that solves real business problems and supports long-term growth.</p></div>
        <a href="/contact/" class="relative inline-flex items-center justify-center bg-accent-bright text-accent-ink font-semibold text-[0.9375rem] px-7 py-3.5 rounded-full transition-colors hover:bg-white">Get in touch</a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-art {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 390px;
    place-items: center;
    isolation: isolate;
  }

  .hero-orbit {
    position: absolute;
    z-index: -1;
    aspect-ratio: 1;
    border: 1px solid rgba(91, 59, 214, 0.1);
    border-radius: 50%;
  }

  .hero-orbit--outer {
    width: min(100%, 440px);
    background: radial-gradient(circle, rgba(238, 234, 255, 0.8), rgba(238, 234, 255, 0.14) 67%, transparent 68%);
  }

  .hero-orbit--inner {
    width: min(78%, 340px);
    border-style: dashed;
    border-color: rgba(91, 59, 214, 0.13);
  }

  .hero-dashboard {
    position: relative;
    width: min(100%, 440px);
    overflow: hidden;
    border: 1px solid rgba(91, 59, 214, 0.17);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 28px 70px -36px rgba(45, 32, 105, 0.32), 0 8px 24px -16px rgba(45, 32, 105, 0.2);
    transform: rotate(-2deg);
  }

  .hero-dashboard__top {
    display: flex;
    height: 42px;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    border-bottom: 1px solid #efedf5;
    background: #fcfbfe;
    color: #918da8;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.06em;
  }

  .hero-window-dots {
    display: flex;
    gap: 4px;
  }

  .hero-window-dots i,
  .hero-live i {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e7a7aa;
  }

  .hero-window-dots i:nth-child(2) {
    background: #edce85;
  }

  .hero-window-dots i:nth-child(3) {
    background: #91c9a8;
  }

  .hero-live {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #52876b;
  }

  .hero-live i {
    width: 5px;
    height: 5px;
    background: #5ab77c;
  }

  .hero-dashboard__body {
    padding: 20px 22px 16px;
  }

  .hero-dash-heading,
  .hero-stat,
  .hero-dashboard__footer > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hero-overline,
  .hero-stat__label {
    color: #8c89a2;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .hero-dash-heading h2 {
    margin-top: 4px;
    color: #252044;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .hero-period {
    padding: 6px 9px;
    border: 1px solid #efedf5;
    border-radius: 6px;
    color: #706d87;
    font-size: 0.62rem;
  }

  .hero-stat {
    margin-top: 18px;
  }

  .hero-stat p {
    margin-top: 3px;
    color: #252044;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .hero-stat p span {
    color: #8274c7;
    font-size: 1rem;
  }

  .hero-stat__change {
    padding: 5px 8px;
    border-radius: 20px;
    background: #eff8f2;
    color: #39845b;
    font-size: 0.65rem;
    font-weight: 600;
  }

  .hero-chart {
    position: relative;
    height: 112px;
    margin-top: 16px;
  }

  .hero-chart__grid {
    position: absolute;
    inset: 0 0 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-chart__grid i {
    border-top: 1px dashed #ebe9f1;
  }

  .hero-chart svg {
    position: absolute;
    inset: 0 0 20px;
    width: 100%;
    height: calc(100% - 20px);
    overflow: visible;
  }

  .hero-chart__labels {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    justify-content: space-between;
    color: #aaa7b8;
    font-family: var(--font-mono);
    font-size: 0.48rem;
  }

  .hero-dashboard__footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 13px;
    padding-top: 13px;
    border-top: 1px solid #efedf5;
  }

  .hero-dashboard__footer > div {
    justify-content: flex-start;
    gap: 6px;
    color: #77748e;
    font-size: 0.58rem;
  }

  .hero-dashboard__footer strong {
    margin-left: auto;
    color: #302b50;
    font-size: 0.62rem;
  }

  .hero-footer-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
  }

  .hero-footer-dot--purple {
    background: #8065e8;
  }

  .hero-footer-dot--teal {
    background: #48b7a1;
  }

  .hero-float-card {
    position: absolute;
    right: -4%;
    bottom: 13%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 15px 11px 11px;
    border: 1px solid #eeebf5;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 28px -18px rgba(45, 32, 105, 0.4);
    transform: rotate(2deg);
  }

  .hero-float-card__icon {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border-radius: 9px;
    background: #edfaf2;
    color: #399a62;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .hero-float-card strong,
  .hero-float-card small {
    display: block;
  }

  .hero-float-card strong {
    color: #302b50;
    font-size: 0.7rem;
  }

  .hero-float-card small {
    margin-top: 2px;
    color: #8c89a2;
    font-size: 0.58rem;
  }

  .hero-art__spark {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 2px solid #9d87ef;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(157, 135, 239, 0.1);
  }

  .hero-art__spark--one {
    top: 14%;
    right: 10%;
  }

  .hero-art__spark--two {
    bottom: 14%;
    left: 9%;
    width: 7px;
    height: 7px;
    border-color: #53b7a2;
    box-shadow: 0 0 0 5px rgba(83, 183, 162, 0.1);
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
      gap: 2rem;
    }

    .hero-art {
      min-height: 340px;
    }

    .hero-dashboard__body {
      padding: 16px;
    }

    .hero-float-card {
      right: -2%;
    }
  }

  @media (max-width: 767px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-art {
      width: min(100%, 480px);
      min-height: 350px;
      margin: 0 auto;
    }

    .hero-float-card {
      right: 0;
      bottom: 8%;
    }
  }

  @media (max-width: 420px) {
    .hero-dashboard__body {
      padding: 14px 12px;
    }

    .hero-dashboard__footer {
      gap: 6px;
    }

    .hero-dashboard__footer > div {
      gap: 4px;
      font-size: 0.52rem;
    }

    .hero-dashboard__footer strong {
      font-size: 0.55rem;
    }

    .hero-float-card {
      right: -2%;
      padding: 8px 10px 8px 8px;
    }
  }
</style>
