---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Contact | Axonite Technology" description="Tell Axonite about your product or software project.">
  <section class="bg-paper py-24 section-rule">
    <div class="max-w-container mx-auto px-6">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] items-start">
        <div class="reveal">
          <p class="eyebrow mb-4">Contact</p>
          <h1 class="text-display max-w-[12ch]">Let's solve your next big challenge.</h1>
          <p class="mt-5 max-w-[56ch] text-[1.05rem] leading-relaxed text-ink-2">
            Tell us about your project, your goals, and the challenges you're facing. We'll discuss your needs, explore the right approach, and help you take the next step with confidence.
          </p>
        </div>

        <aside class="card p-8 reveal">
          <p class="eyebrow mb-4">Reach us</p>
          <h2 class="text-display-xs">Axonite Technology</h2>
          <ul class="mt-6 space-y-4 text-[0.95rem] leading-relaxed text-ink-2">
            <li><strong class="text-ink">Email:</strong> hello@axonite.co</li>
            <li><strong class="text-ink">Phone:</strong> +91 98231 03626</li>
            <li><strong class="text-ink">Location:</strong> Pune, Maharashtra</li>
          </ul>
          <div class="mt-8 rounded-md border border-line bg-paper p-4">
            <p class="font-mono-label text-[0.68rem] text-ink-3">Get in Touch</p>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-2">Contact us directly by email or phone to discuss your project.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</SiteLayout>
